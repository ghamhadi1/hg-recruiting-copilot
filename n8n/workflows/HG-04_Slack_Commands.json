    {
      "name": "Call Search API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "__N8N_BASE_URL__/webhook/__WH__-search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $('Verify Command').first().json.question, role_id: $('Verify Command').first().json.role_id, source: 'slack' }) }}",
        "options": {
          "timeout": 150000
        }
      },
      "credentials": {
