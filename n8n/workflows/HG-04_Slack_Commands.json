      ]
    },
    {
      "name": "Results Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Posts the search answer back to the channel where /find was typed.\nconst cmd = $('Verify Command').first().json;\nconst r = $input.first().json || {};\nlet body;\nif (r.error || !r.ok) {\n  body = { response_type: 'ephemeral', replace_original: false,\n    text: '⚠️ Search failed: ' + String((r.error && (r.error.message || r.error)) || 'unknown error').slice(0, 300) };\n} else {\n  body = { response_type: 'in_channel', replace_original: false, text: r.text, blocks: r.blocks };\n}\nreturn [{ json: { url: cmd.response_url, body: body } }];\n"
      },
      "id": "0351e923-1082-511f-b8c1-4774b33f1512",
      "position": [
        1820,
        -200
