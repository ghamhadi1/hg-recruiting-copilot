# Copy this file to ".env" and fill it in. NEVER commit .env (it is in .gitignore).
# It is only read by scripts/setup.py on your own computer.

# --- Supabase (Project Settings → API Keys). Prefer the legacy "service_role" key (starts with eyJ).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# --- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- n8n
N8N_BASE_URL=https://n8ndemo.remotelyx.com
# Optional but recommended: n8n → Settings → n8n API → Create API key. Lets the script import everything for you.
N8N_API_KEY=
# Unique prefix for webhook URLs on the shared n8n server
WEBHOOK_PATH_PREFIX=hg-p3
# Leave empty: setup.py generates a random secret and writes it back here
WEBHOOK_SECRET=

# --- Slack (api.slack.com/apps → your app)
SLACK_BOT_TOKEN=xoxb-
SLACK_VERIFICATION_TOKEN=
SLACK_CHANNEL_ID=

# --- GoHighLevel sandbox (the Location ID + API key from the brief go HERE, nowhere else)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_NAME=HG- Candidates

# --- Safety: while testing, every email goes to YOUR inbox (as you+hg-c12@gmail.com aliases)
TEST_RECIPIENT=your.own.address@gmail.com
SENDER_NAME=HG Talent Team

# --- Portal (filled after you deploy on Vercel)
PORTAL_URL=
PORTAL_PASSWORD=

# --- Only if you created n8n credentials by hand: paste each credential's ID
# (open the credential in n8n; the ID is the last part of the URL)
N8N_CRED_SUPABASE=
N8N_CRED_OPENAI=
N8N_CRED_SLACK=
N8N_CRED_GHL=
N8N_CRED_WEBHOOK=
N8N_CRED_GMAIL=
